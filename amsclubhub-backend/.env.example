PROJECT_NAME="AmsClubHub Backend"
API_V1_STR="/api/v1"
SECRET_KEY=your_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

POSTGRES_SERVER=localhost
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_db
POSTGRES_PORT=5432

DATABASE_URL=your_db_url
REDIS_URL=your_redis_url

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_NAME=AmsClubHub

BREVO_API_KEY=
# Sender address trên domain ĐÃ XÁC MINH với Brevo (Sender/domain => https://app.brevo.com/senders)
# Định dạng: "Tên <email@domain-xac-minh.com>", fallback về SMTP
EMAILS_FROM=
EMAIL_TIMEOUT_SECONDS=10
