PROJECT_NAME="AmsClubHub Backend"
API_V1_STR="/api/v1"
SECRET_KEY="DANGEROUS_SECRET_KEY_CHANGE_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=amsclubhub_db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amsclubhub_db
REDIS_URL=redis://localhost:6379/0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_NAME=AmsClubHub

BREVO_API_KEY=
# Sender address trên domain ĐÃ XÁC MINH với Brevo (Sender/domain => https://app.brevo.com/senders)
# Định dạng: "Tên <email@domain-xac-minh.com>", fallback về SMTP
EMAILS_FROM=
EMAIL_TIMEOUT_SECONDS=10
