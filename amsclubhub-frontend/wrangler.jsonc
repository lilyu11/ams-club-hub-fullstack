{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amsclubhub-frontend",
  "main": ".vercel/output/static/_worker.js/index.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
	"nodejs_compat"
  ],
  "assets": {
	"binding": "ASSETS",
	"directory": ".vercel/output/static"
  }
}